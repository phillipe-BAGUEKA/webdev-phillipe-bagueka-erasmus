{
  "context": {
    "fileName": ["AGENTS.md"]
  },
  "mcpServers": {
    "my-project": {
      "command": ".venv/Scripts/python.exe",
      "args": ["mcp-server/server.py", "--project"],
      "cwd": ".",
      "env": {
        "DJANGO_SETTINGS_MODULE": "src.config.postgres",
        "LAB_BOOKING_MCP_SESSION": "$LAB_BOOKING_MCP_SESSION"
      }
    }
  }
}
