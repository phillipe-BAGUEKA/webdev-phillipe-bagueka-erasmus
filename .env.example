# Template for a future Render web service. Enter real values in the dashboard only.
# Django signing secret: generate a fresh random value for the deployed service.
DJANGO_SECRET_KEY=replace-with-a-new-random-secret
# Build/example value only: sslmode=require encrypts but does not verify server
# identity. Before Neon/Render, test verify-full with a trusted CA in the image.
# Never reuse the local 5433 profile.
DATABASE_URL=postgresql://user:placeholder@host.example/dbname?sslmode=require
# Exact Render hostname and HTTPS origin; no wildcard.
DJANGO_ALLOWED_HOSTS=your-service.onrender.com
DJANGO_CSRF_TRUSTED_ORIGINS=https://your-service.onrender.com
# Render sets PORT. Gunicorn defaults to 10000 if it is not supplied.
PORT=10000
# Optional: the suggestion feature remains disabled without explicit enablement.
LAB_BOOKING_AI_ENABLED=0
GEMINI_API_KEY=
# Reserved for the planned Google OIDC feature; the current app does not read them.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Optional for a separate local MCP process only; never put a real token in Render.
LAB_BOOKING_MCP_SESSION=
